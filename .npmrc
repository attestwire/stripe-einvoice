# npm 10.9.x's arborist throws "Cannot read properties of null (reading
# 'edgesOut')" resolving vitest 4.1.x's optional peer @vitest/browser-playwright
# during a plain `npm install` here. `--legacy-peer-deps` (npm v6-style peer
# resolution) sidesteps the buggy code path; nothing in this package actually
# needs npm 7+'s automatic peer install. Safe to remove once upstream fixes it.
legacy-peer-deps=true
